# Copie este arquivo para .env e preencha com seus valores reais.
# Nunca commitar o .env (contém segredos).

# Chave da API do Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# String de conexão do MongoDB
MONGODB_URI=mongodb://localhost:27017

# Nome do banco de dados usado pela aplicação
MONGODB_DB_NAME=ecomentor

# development | production
ENVIRONMENT=development
