# Copie este arquivo para .env e preencha com seus valores reais.
# Nunca commitar o .env (contém segredos).

# Credenciais da Groq (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# String de conexão do MongoDB
MONGODB_URI=mongodb://localhost:27017

# Nome do banco de dados usado pela aplicação
MONGODB_DB_NAME=ecomentor

# development | production
ENVIRONMENT=development
